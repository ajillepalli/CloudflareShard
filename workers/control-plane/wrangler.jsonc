{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudflare-shard-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "JOURNAL_MANIFEST",
        "class_name": "JournalManifestDO"
      },
      {
        "name": "FLEET_MANIFEST_CATALOG",
        "class_name": "FleetManifestCatalogDO"
      }
    ]
  },
  "exports": {
    "JournalManifestDO": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "FleetManifestCatalogDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
